# Django Core Settings
SECRET_KEY=change-me-in-production-use-a-strong-secret-key-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Leave empty for default local SQLite, or provide postgresql URL e.g. from Neon)
# DATABASE_URL=postgresql://user:password@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# CORS Settings (Explicit origins for frontend, never use * in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Settings
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
